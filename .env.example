# ── Application ──────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true
APP_NAME="AI Governance Tools"
APP_VERSION=1.0.0

# ── Security ─────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32_output
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ag_db
POSTGRES_USER=ag_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DATABASE_URL=postgresql+asyncpg://ag_user:CHANGE_ME_strong_password@db:5432/ag_db
DATABASE_URL_SYNC=postgresql://ag_user:CHANGE_ME_strong_password@db:5432/ag_db

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
REDIS_DENYLIST_DB=1
REDIS_CACHE_DB=2

# ── Celery ────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_redis_password@redis:6379/0

# ── GCP ───────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_DQ_DATASET=dq_governance
GCP_BUCKET_DQ_OUTPUTS=dq-governance-outputs
GCP_BUCKET_EXPORTS=governance-exports
GCP_BUCKET_BAPD=bapd-evidence

# ── Ollama (Local LLM) ────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_FALLBACK_MODEL=mistral:7b
OLLAMA_TIMEOUT_SECONDS=30

# ── Email / Notifications ─────────────────────────────────────────────────
EMAIL_PROVIDER=smtp                  # smtp | sendgrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=CHANGE_ME_app_password
SMTP_FROM_NAME="AI Governance Tools"
SMTP_FROM_EMAIL=noreply@your-domain.com
SENDGRID_API_KEY=CHANGE_ME_if_using_sendgrid

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="AI Governance Tools"
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SECONDS=60

# ── File Upload ───────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
UPLOAD_TEMP_DIR=/tmp/ag_uploads
UPLOAD_RETENTION_HOURS=24
